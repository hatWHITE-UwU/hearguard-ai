#!/bin/sh
# Enforce conventional commit format: type(scope): description
commit_regex='^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\(.+\))?: .{1,100}$'
commit_msg=$(cat "$1")

if ! echo "$commit_msg" | grep -qE "$commit_regex"; then
  echo ""
  echo "  ERROR: Commit message does not follow Conventional Commits format."
  echo "  Expected: type(scope): description"
  echo "  Example:  feat(auth): add refresh token rotation"
  echo "  Types:    feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert"
  echo ""
  exit 1
fi
