{
  "name": "hearguard-ai",
  "private": true,
  "description": "Monorepo HearGuard — usar scripts para levantar todo el stack",
  "scripts": {
    "backend:dev": "npm run dev --prefix backend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:backend": "docker compose up --build mongodb ai-service backend",
    "mongo:local": "docker compose up -d mongodb",
    "prepare": "husky",
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "cd frontend && npm run lint",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm run test:ci -- --browsers=chromium",
    "test:ai": "cd ai-service && pytest tests/ -q",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:ai"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0"
  }
}
