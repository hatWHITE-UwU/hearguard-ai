# ── HearGuard AI — variables de entorno ──────────────────────────────────────
# Copia este archivo como .env en la raíz y completa los valores.
# NUNCA commitees el .env real (está en .gitignore).

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# MongoDB Atlas → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/hearguard?retryWrites=true&w=majority

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — URL del frontend en producción
FRONTEND_URL=http://localhost:4200

# URL interna del servicio de IA
AI_SERVICE_URL=http://localhost:5001

# ── AI Service ────────────────────────────────────────────────────────────────
# Lista separada por comas (vacío = todos)
ALLOWED_ORIGINS=
FLASK_DEBUG=0

# ── Frontend (Angular) ────────────────────────────────────────────────────────
# URL pública del backend — usada por scripts/set-env.js en build de producción
API_URL=https://api.hearguard.onrender.com
PUBLIC_DEMO=false

# ── GitHub Actions Secrets (no van en .env, solo documentación) ───────────────
# RENDER_BACKEND_HOOK  → Render Dashboard → Service → Settings → Deploy Hook
# RENDER_AI_HOOK       → Render Dashboard → Service → Settings → Deploy Hook
# BACKEND_URL          → URL pública del backend desplegado
# VERCEL_TOKEN         → vercel.com/account/tokens
# VERCEL_ORG_ID        → campo orgId en .vercel/project.json
# VERCEL_PROJECT_ID    → campo projectId en .vercel/project.json
