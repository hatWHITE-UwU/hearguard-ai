NODE_ENV=development
PORT=3000

# MongoDB Atlas — reemplaza <user> y <password> con tus credenciales
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/hearguard?appName=Cluster0

# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=<min-64-bytes-random-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<min-64-bytes-random-refresh-secret>
JWT_REFRESH_EXPIRES_IN=7d

# URL del frontend (localhost en dev, dominio Vercel en prod)
FRONTEND_URL=http://localhost:4200

# Microservicio de IA
AI_SERVICE_URL=http://localhost:5001
